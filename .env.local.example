# Visa Cal credentials
VISA_CAL_ID=          # Israeli national ID number
VISA_CAL_PASSWORD=    # Online banking password
VISA_CAL_CARD6=       # Last 6 digits of card number

# Max (Leumi Card) credentials
MAX_ID=               # Israeli national ID number
MAX_PASSWORD=         # Online banking password
MAX_CARD6=            # Last 6 digits of card number

# Leumi bank account credentials (optional - real balance + income, not just card spend)
# Note: if Leumi prompts SMS OTP on this login, the headless scrape will just fail -
# there is no manual-OTP flow. Card scraping above is unaffected either way.
LEUMI_ID=              # Israeli national ID number
LEUMI_PASSWORD=        # Online banking password

# Telegram bot (optional - for daily summaries and alerts)
TELEGRAM_BOT_TOKEN=   # Get from @BotFather on Telegram
TELEGRAM_CHAT_ID=     # Your chat ID (send /start to @userinfobot to find it)

# App auth (required once deployed publicly, e.g. on Railway) - HTTP Basic Auth
APP_USER=              # any username you choose
APP_PASSWORD=          # any password you choose

# Cron endpoint protection for /api/daily-summary
CRON_SECRET=
